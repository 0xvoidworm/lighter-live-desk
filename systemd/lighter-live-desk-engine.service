[Unit]
Description=Lighter Live Desk engine (starts with entries stopped)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/lighter-live-desk
ExecStart=%h/lighter-live-desk/.venv/bin/lldesk engine
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
